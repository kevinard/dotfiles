#!/bin/sh
set -eu
case ":${XDG_CURRENT_DESKTOP:-}:" in *:niri:*) ;; *) exit 0 ;; esac
# Applied in a graphical login, where the session D-Bus and dconf are available.
gsettings set org.gnome.desktop.interface color-scheme {{ if eq .themeFlavour "latte" }}default{{ else }}prefer-dark{{ end }}
gsettings set org.gnome.desktop.interface font-name 'sans-serif 11'
gsettings set org.gnome.desktop.interface gtk-theme Adwaita{{ if ne .themeFlavour "latte" }}-dark{{ end }}
gsettings set org.gnome.desktop.interface icon-theme {{ if eq .themeFlavour "latte" }}Papirus-Light{{ else }}Papirus-Dark{{ end }}
gsettings set org.gnome.desktop.interface cursor-theme Adwaita
