#!/usr/bin/env sh

# progress-notify - Send audio and brightness notifications for the desktop notification daemon

# dependencies: notify-send, wpctl, Papirus (icons)

### How to use: ###
# Pass the values via stdin and provide the notification type
# as an argument. Options are audio and brightness

### Audio notifications ###
#   wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}' | notify-progress audio
### Brightness notifications ###
#   brightnessctl -m s 5%- | awk -F',' '{print $4+0}' | notify-progress brightness

notifyMuted() {
  volume="$1"
  notify-send -h string:x-canonical-private-synchronous:audio "Muted" -h int:value:"$volume" -t 1500 --icon audio-volume-muted
}

notifyAudio() {
  volume="$1"
  muted=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print ($3 == "[MUTED]" ? 1 : 0)}')

  if [ "${muted:-0}" -eq 1 ] || [ $volume -eq 0 ]; then
    notifyMuted "$volume"
  elif [ $volume -le 30 ]; then
    notify-send -h string:x-canonical-private-synchronous:audio "Volume: " -h int:value:"$volume" -t 1500 --icon audio-volume-low
  elif [ $volume -le 70 ]; then
    notify-send -h string:x-canonical-private-synchronous:audio "Volume: " -h int:value:"$volume" -t 1500 --icon audio-volume-medium
  else
    notify-send -h string:x-canonical-private-synchronous:audio "Volume: " -h int:value:"$volume" -t 1500 --icon audio-volume-high
  fi
}

notifyBrightness() {
  brightness="$1"
  if [ $brightness -eq 0 ]; then
    notify-send -h string:x-canonical-private-synchronous:brightness "Brightness: " -h int:value:"$brightness" -t 1500 --icon display-brightness-off-symbolic
  elif [ $brightness -le 30 ]; then
    notify-send -h string:x-canonical-private-synchronous:brightness "Brightness: " -h int:value:"$brightness" -t 1500 --icon display-brightness-low-symbolic
  elif [ $brightness -le 70 ]; then
    notify-send -h string:x-canonical-private-synchronous:brightness "Brightness: " -h int:value:"$brightness" -t 1500 --icon display-brightness-medium-symbolic
  else
    notify-send -h string:x-canonical-private-synchronous:brightness "Brightness: " -h int:value:"$brightness" -t 1500 --icon display-brightness-high-symbolic
  fi
}

set -eu
input=$(cat /dev/stdin)
case "$input" in ""|*[!0-9]*) echo "Expected an integer percentage" >&2; exit 2 ;; esac

case "${1:-}" in
audio)
  notifyAudio "$input"
  ;;
brightness)
  notifyBrightness "$input"
  ;;
*)
  echo "Not the right arguments"
  echo "${1:-}"
  exit 2
  ;;
esac
