#!/usr/bin/env python3
"""Adjust each DDC display, including identical models, from the user session."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time


def topology(root=Path("/sys/class/drm")):
    digest = hashlib.sha256()
    for connector in sorted(root.glob("card*-*")):
        for name in ("status", "edid"):
            try:
                digest.update(str(connector / name).encode())
                digest.update((connector / name).read_bytes())
            except OSError:
                pass
    return digest.hexdigest()


def displays(output):
    return re.findall(r"^Display\s+(\d+)\b", output, re.MULTILINE)


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("up", "down", "clear"):
        raise SystemExit("Usage: brightness-control {up|down} {zero-based-index|all}, or clear")
    action = sys.argv[1]
    cache_dir = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "ddc-brightness"
    cache_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    cache = cache_dir / "displays.json"
    with (cache_dir / "lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == "clear":
            cache.unlink(missing_ok=True)
            return
        if len(sys.argv) != 3:
            raise SystemExit("Expected a display index or all")
        fingerprint = topology()
        try:
            record = json.loads(cache.read_text())
        except (OSError, ValueError):
            record = {}
        if record.get("topology") != fingerprint or time.time() - record.get("time", 0) > 30:
            result = subprocess.run(["ddcutil", "detect", "--brief"], check=True, capture_output=True, text=True)
            record = {"topology": fingerprint, "time": time.time(), "displays": displays(result.stdout)}
            cache.write_text(json.dumps(record))
        selected = record["displays"]
        if sys.argv[2] != "all":
            if not sys.argv[2].isdigit() or int(sys.argv[2]) >= len(selected):
                raise SystemExit("Invalid display index")
            selected = [selected[int(sys.argv[2])]]
        if not selected:
            raise SystemExit("No DDC displays detected")
        for display in selected:
            result = subprocess.run(["ddcutil", "--display", display, "setvcp", "10",
                                     "+" if action == "up" else "-", "10"])
            if result.returncode:
                cache.unlink(missing_ok=True)
                raise SystemExit(result.returncode)


if __name__ == "__main__":
    main()
