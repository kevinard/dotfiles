{{- $m := includeTemplate "machine" . | fromJson -}}
{{- $p := index .packages .chezmoi.osRelease.id -}}
{{- $items := $p.common -}}
{{- if eq .chezmoi.osRelease.id "arch" -}}
{{- $items = concat $items $p.niri (index $p $m.shell) -}}
{{- if eq $m.power "tlp" }}{{ $items = concat $items $p.tlp }}{{ end -}}
{{- if eq $m.power "native" }}{{ $items = concat $items $p.native }}{{ end -}}
{{- if $m.scheduler }}{{ $items = concat $items $p.scheduler }}{{ end -}}
{{- if ne $m.cpu "none" }}{{ $items = concat $items (index $p (printf "%s_cpu" $m.cpu)) }}{{ end -}}
{{- if ne $m.gpu "none" }}{{ $items = concat $items (index $p (printf "%s_graphics" $m.gpu)) }}{{ end -}}
{{- if eq .env "home" }}{{ $items = concat $items $p.personal }}{{ end -}}
{{- end -}}
{{- $items | uniq | shellQuoteList | join " " -}}
