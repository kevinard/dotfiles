[Unit]
Description=Local start page (8081)
{{ includeTemplate "graphical-unit" . }}
ConditionPathIsDirectory=%h/scalingo/tools-and-hacks/startpage

[Service]
WorkingDirectory=%h/scalingo/tools-and-hacks/startpage
ExecStart=/usr/bin/python3 -m http.server 8081 --bind 127.0.0.1
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
