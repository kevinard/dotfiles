[Unit]
Description=Clipboard history (%I)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=NIRI_SOCKET

[Service]
Slice=session.slice
ExecStart=wl-paste --type %i --watch %h/.local/bin/clipboard-store
Restart=on-failure
RestartSec=3
