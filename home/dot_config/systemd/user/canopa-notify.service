[Unit]
Description=Canopa notification daemon
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
ExecStart=%h/.local/bin/canopa-notify daemon --service --socket %t/canopa-notify/control.sock
Restart=on-failure
RestartSec=3
