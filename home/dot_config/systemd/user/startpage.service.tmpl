[Unit]
Description=Local start page (8080)
{{ includeTemplate "graphical-unit" . }}
ConditionPathIsDirectory=%h/.local/share/tilde

[Service]
WorkingDirectory=%h/.local/share/tilde
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
