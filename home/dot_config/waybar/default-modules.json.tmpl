{
  "niri/workspaces": {"format": "{icon}", "format-icons": {"active": "●", "default": ""}},
  "niri/window": {"max-length": 60},
  "tray": {"spacing": 10},
  "clock": {"format": "{:%a %d %b %H:%M}"},
  "battery": {"format": "{capacity}% {icon}", "states": {"warning": 20, "critical": 10}, "format-icons": ["󰂎", "󰁾", "󰁹"]},
  "network": {
    "format-wifi": " {essid}", "format-ethernet": "󰈀", "format-disconnected": "⚠",
    "on-click": "kitty -e {{ if eq .chezmoi.osRelease.id "arch" }}iwctl{{ else }}nmtui{{ end }}"
  },
  "pulseaudio": {"format": "{volume}% {icon}", "format-muted": "󰖁", "format-icons": {"default": ["", "", ""]}, "on-click": "pavucontrol"},
  "idle_inhibitor": {"format": "{icon}", "format-icons": {"activated": "", "deactivated": ""}},
  "custom/dunst": {"exec": "$HOME/.config/waybar/scripts/dunst.sh", "on-click": "dunstctl set-paused toggle", "return-type": "json", "restart-interval": 1},
  "custom/power": {"format": "", "on-click": "rofi -show powermenu -theme powermenu"}
}
