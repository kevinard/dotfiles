{
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/window": {
    "max-length": 60,
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}"
  },
  "hyprland/submap": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true
  },
  "niri/workspaces": {
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
	    "active": "●",
	    "default": ""
	  },
    "disable-click": false
  },
  "niri/window": {
    "separate-outputs": true
  },
  "tray": {
    "spacing": 10,
    "reverse-direction": true,
    //"icon-size": 16,
    //"rotate": 0,
    //"spacing": 3
  },
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "locale": "fr_FR.utf8",
    "tooltip": false
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 20,
      "critical": 10
    },
    //"format": "{capacity}% {icon}",
    "format": "{icon} ",
    //"format-charging": "{capacity}% ",
    //"format-charging": "{capacity}% {icon}󱐋",
    "format-charging": "{icon}󱐋 ",
    "format-plugged": "󰂄",
    "tooltip-format": "{capacity}%\n{timeTo}\n{power}W",
    //"format-icons": ["", "", "", "", ""],
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "network": {
    "format-wifi": " ",
    //"format-ethernet": "",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "⚠ ",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}\n {bandwidthUpBits} -  {bandwidthDownBits}",
    "tooltip-format-ethernet": "{ifname}\n {bandwidthUpBits} -  {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
{{- if eq .env "home" }}
    "on-click": "iwmenu -m rofi",
    "on-right-click": "kitty -e iwctl",
{{- end }}
{{- if eq .env "work" }}
    "on-click": "$HOME/.config/rofi/scripts/wifimenu.sh",
    "on-right-click": "kitty -e nmtui",
{{- end }}
    "interval": 2
  },
  "pulseaudio": {
    //"format": "{volume}% {icon}",
    "format": "{icon} ",
    //"format-bluetooth": "{volume}% {icon}",
    //"format-muted": "{volume}% 󰖁",
    "format-muted": "󰖁 ",
    "tooltip-format": "{icon} {desc} // {volume}%",
    "format-icons": {
      "headphones": "",
      "headphone": "",
      "handsfree": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "on-right-click": "qpwgraph"
  },
  "pulseaudio/slider": {
    "min": 5,
    "max": 100,
    "rotate": 0,
    "device": "pulseaudio",
    "scroll-step": 1,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    }
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "custom/power": {
      "format": " ",
      "tooltip": false,
      "on-click": "rofi -show powermenu -theme powermenu",
      "interval" : 86400
  },
  "custom/dunst": {
    "exec": "$HOME/.config/waybar/scripts/dunst.sh",
    "on-click": "dunstctl set-paused toggle",
    "return-type": "json",
    "restart-interval": 1,
  },

"custom/smallspacer":{
"format": " ",
},
   "group/expand": {
     "orientation": "horizontal",
     "drawer": {
         "transition-duration": 600,
         "children-class": "not-power",
       "transition-to-left": true,
       //  "click-to-reveal": true
     },
     "modules": ["custom/menu","custom/spacer","tray", "custom/pacman", "idle_inhibitor"]
   },
 "custom/menu":{
 "format": "󰅃",
 "rotate": 90,
 },
    "custom/spacer":{
    "format": "|"
    },
    "group/expand-3": {
     "orientation": "horizontal",
     "drawer": {
         "transition-duration": 600,
         "children-class": "not-power",
       "transition-to-left": true,
         //"click-to-reveal": true
     },
     "modules": ["pulseaudio","pulseaudio/slider"]
   },
// modules for padding //
    "custom/l_end": {
        "format": " ",
        "interval" : "once",
        "tooltip": false
    },
    "custom/padd": {
        "format": "  ",
        "interval" : "once",
        "tooltip": false
    },


{{- if eq .env "home" }}
  "custom/media": {
    "format": "{icon} {}",
    "format-icons": {
      "spotify": "",
      "default": "🎜"
    },
    "escape": true,
    "return-type": "json",
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "smooth-scrolling-threshold": 10, // This value was tested using a trackpad, it should be lowered if using a mouse.
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null", // Script in resources/custom_modules folder
  },
  "custom/pacman": {
    "format": "{} ",
    "interval": 3600,                     // every hour
    "exec": "checkupdates | wc -l",       // # of updates
    "exec-if": "[[ `checkupdates | wc -l` -gt 0 ]]",
    "on-click": "kitty sh -c 'paru -Syu'; pkill -SIGRTMIN+8 waybar", // update system
    "signal": 8
  }
{{- end }}
}
