{{- $m := includeTemplate "machine" . | fromJson -}}
{
  "layer": "top",
  "position": "top",
  "include": ["~/.config/waybar/default-modules.json"],
  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "idle_inhibitor", "pulseaudio", "network"{{ if $m.battery }}, "battery"{{ end }}, "custom/dunst", "custom/power"]
}
