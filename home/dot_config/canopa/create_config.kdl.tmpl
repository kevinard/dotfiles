{{- $m := includeTemplate "machine" . | fromJson -}}
{{- $p := index .palettes .themeFlavour -}}
// Bundled Canopa spine, quick settings, applications and session confirmations.
// Created only when missing so Settings can edit it.
schema-version 1
appearance {
    color-scheme "{{ if eq .themeFlavour "latte" }}light{{ else }}dark{{ end }}"
    accent "{{ index $p .themeColor }}"
    typography { family "Inter" "Noto Sans" "sans-serif"; }
}
shell {
    bar "main" {
        edge "left"
        thickness 64
        margin 12
        ui { background "spine"; radius 28; border width=0; padding 12 10; gap 8; }
        actions { click { open-panel; }; }
        modules {
            start "launcher" "overview"
            center "workspaces"
            end "tray" "notifications" "system" "clock"
        }
        panel {
            title "Quick settings"
            presentation "drawer"
            drawer-mode "overlay"
            width 392
            ui { margin 12 0; radius 24; border width=0; }
            start "network" "volume"
            center "notifications" "media" "idle-inhibitor"
            end{{ if $m.battery }} "battery"{{ end }} "settings" "wallpaper" "files" "session-lock" "session-logout" "session-reboot" "session-poweroff"
        }
    }
    modules {
        module "launcher" {
            type "button"
            icon "canopa:mark"
            label "Applications"
            ui { padding 12 0; foreground "accent"; }
            actions { click { toggle-menu "Applications"; }; }
        }
        module "overview" {
            type "button"
            icon "canopa:overview"
            label "Overview"
            actions { click { command { argv "niri" "msg" "action" "toggle-overview"; }; }; }
        }
        module "system" {
            type "button"
            icon "canopa:controls"
            label "Quick settings"
            actions { click { toggle-bar-panel; }; }
        }
        module "settings" {
            type "button"
            icon "preferences-system"
            label "Settings"
            actions { click { launch "canopa-settings"; }; }
        }
        module "wallpaper" {
            type "button"
            icon "preferences-desktop-wallpaper"
            label "Wallpaper"
            actions { click { launch "canopa" "wallpaper" "pick"; }; }
        }
        module "files" {
            type "button"
            icon "system-file-manager"
            label "Files"
            actions { click { launch "canopa-files"; }; }
        }
        module "session-lock" {
            type "button"
            icon "canopa:lock"
            label "Lock"
            actions { click { launch "desktop-lock"; }; }
        }
        module "session-logout" {
            type "button"
            icon "canopa:logout"
            label "Log out"
            actions { click { open-menu "Log out?"; }; }
        }
        module "session-reboot" {
            type "button"
            icon "canopa:reboot"
            label "Reboot"
            actions { click { open-menu "Reboot?"; }; }
        }
        module "session-poweroff" {
            type "button"
            icon "canopa:poweroff"
            label "Power off"
            actions { click { open-menu "Power off?"; }; }
        }
        module "idle-inhibitor" { backend "stasis"; }
        module "clock" { format "{time}"; ui { padding 16 0; }; }
    }
    menus {
        menu "Applications" show-icons=#true prompt="Search apps and files" { source "launcher"; }
        menu "Log out?" prompt="Unsaved work may be lost" {
            item "Cancel" { open-bar-panel; }
            item "Log out" { command { argv "niri" "msg" "action" "quit" "--skip-confirmation"; }; }
        }
        menu "Reboot?" prompt="Unsaved work may be lost" {
            item "Cancel" { open-bar-panel; }
            item "Reboot" { command { argv "systemctl" "reboot"; }; }
        }
        menu "Power off?" prompt="Unsaved work may be lost" {
            item "Cancel" { open-bar-panel; }
            item "Power off" { command { argv "systemctl" "poweroff"; }; }
        }
    }
}
notifications {
    sound enabled=#true theme="freedesktop" default="message-new-instant"
    icons theme="Papirus" scale=1
}
wallpaper {
    color "{{ $p.base }}"
    fit "fill"
}
lockscreen {
    use-wallpaper #true
    dim 65
    clock-format "%H:%M"
    date-format "%A, %d %B"
    widgets "username" "keyboard"{{ if $m.battery }} "battery"{{ end }}
}
polkit { font "Inter"; auth-timeout 120; }
pinentry { font "Inter"; auth-timeout 120; }
