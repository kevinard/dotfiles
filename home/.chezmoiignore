{{- $m := includeTemplate "machine" . | fromJson }}
**/__pycache__
**/*.pyc
{{ if not $m.scheduler }}
.config/systemd/user/system76-scheduler-niri.service
{{ end }}
{{ if ne $m.shell "canopa" }}
.config/canopa
.config/systemd/user/canopa-*.service.d
.config/systemd/user/canopa-session.target.d
.config/systemd/user/xdg-desktop-portal-canopa.service.d
.config/xdg-desktop-portal/canopa-portals.conf
{{ end }}
{{ if eq $m.shell "canopa" }}
.config/systemd/user/kanshi.service
.config/systemd/user/swayidle.service
.config/systemd/user/thunar.service
{{ end }}
{{ if ne $m.shell "waybar" }}
.config/waybar
.config/systemd/user/waybar.service
.config/systemd/user/dunst.service.d
{{ end }}
{{ if not $m.battery }}
.config/systemd/user/battery-alert.*
{{ end }}
{{ if ne .env "home" }}
.local/share/dbus-1/services/org.freedesktop.secrets.service
{{ end }}
