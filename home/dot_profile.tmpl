# Portable login environment (also read by niri-session).
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export SCALINGO_HOME="$HOME/scalingo"
export GOPATH="$HOME/go"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export ANSIBLE_HOME="$XDG_DATA_HOME/ansible"
export DOCKER_CONFIG="$XDG_DATA_HOME/docker"
export PATH="$HOME/.local/bin:$CARGO_HOME/bin:$GOPATH/bin:$PATH"
# GUI launches can use mise shims without evaluating an interactive activation.
if [ -d "$XDG_DATA_HOME/mise/shims" ]; then export PATH="$XDG_DATA_HOME/mise/shims:$PATH"; fi
# Preserve existing legacy managers until their tool versions have been migrated.
export VOLTA_HOME="$HOME/.volta"
for tool_bin in "$HOME/.tfenv/bin" "$HOME/.rbenv/bin" "$VOLTA_HOME/bin" /usr/local/go/bin; do
    if [ -d "$tool_bin" ]; then export PATH="$PATH:$tool_bin"; fi
done
export EDITOR=nvim VISUAL=nvim PAGER=less
export TERMINAL=kitty
{{ if eq .chezmoi.osRelease.id "arch" -}}
export BROWSER=firefox READER=zathura
{{ end -}}
export LANG=en_US.UTF-8
export LESS='-g -i -M -R -S -w -X -z-4'
export LESSHISTFILE=/dev/null
if [ -z "${LESSOPEN:-}" ]; then
    for preprocessor in lesspipe lesspipe.sh; do
        if command -v "$preprocessor" >/dev/null 2>&1; then
            LESSOPEN="| $preprocessor %s"
            export LESSOPEN
            break
        fi
    done
fi
export CATPPUCCIN_FLAVOUR={{ .themeFlavour | shellQuote }}
# Keep the existing GNOME/work agent; Arch uses the managed SSH agent socket.
{{ if and (eq .env "home") (eq .chezmoi.osRelease.id "arch") }}
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"; fi
{{ end }}
