# mkinitcpio preset file for the 'linux' package

ALL_config="/etc/mkinitcpio-fallback.conf"
ALL_kver="/boot/vmlinuz-linux-lts"

PRESETS=('fallback')

fallback_uki="/efi/EFI/Linux/arch-linux-lts-fallback.efi"
# Uses the same tested /etc/kernel/cmdline as the primary kernel.
# MODULES and kernel autodetection are not required for the fallback initramfs.
