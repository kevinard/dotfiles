// SPDX-License-Identifier: MPL-2.0
// Adapted from pop-os/system76-scheduler's application assignments.
// Own Arch's packaged filename so its development rules cannot override ours.
assignments {
    desktop-environment {
        niri
        xwayland-satellite
        swaylock
        canopa
        canopa-shell
        canopa-notify
        canopa-wallpaper
        canopa-lock
        canopa-idle
        canopa-polkit
        canopa-pinentry
        xdg-desktop-portal-canopa
        canopa-wifi-provider
        canopa-audio-provider
        canopa-media-provider
        waybar
        dunst
        cosmic-comp
        gnome-shell
        i3wm
        kwin
        sway
        Hyprland
        gamescope
        Xorg
    }
    interactive-development {
        rust-analyzer
        clangd
        gopls
        typescript-language-server
        pyright-langserver
    }
    recording {
        amsynth
        easyeffects
        jamesdsp
        jitsi
        mumble
        obs
        teams
        wireplumber
        zoom
        bitwig-studio
        include name="Bitwig*"
    }
    games {
        lutris
        steam
        heroic
        itch
        vrcompositor
        vrdashboard
        vrmonitor
        vrserver
        include descends="steam"
        include descends="lutris"
        include descends="heroic"
        include descends="itch"
    }
    package-manager {
        pacman
        makepkg
        include name="apt-*"
        include name="dpkg-*"
        apt
        dpkg
        flatpak
        fwupd
        packagekitd
        update-initramfs
    }
    batch {
        "7z"
        "7za"
        "7zr"
        ar
        boinc
        c++
        cargo
        clang
        cmake
        cpp
        fossilize-replay
        g++
        gcc
        gradle
        javac
        ld
        lld
        make
        mold
        mvn
        ninja
        rustc
        sbuild
        tar
        tracker-miner-fs-3
        unrar
        zip
    }
}
