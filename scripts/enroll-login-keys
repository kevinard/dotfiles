#!/usr/bin/env python3
"""Stage two PAM authenticator registrations; never install or activate PAM policy."""
import argparse
import os
from pathlib import Path
import pwd
import shutil
import subprocess
import sys


ORIGIN = "pam://kevinard-linux"
REPO = Path(__file__).resolve().parents[1]


def registration(output, username):
    """Accept exactly one registration for this user, not extra mapping lines."""
    line = output.strip()
    if "\n" in line or "\r" in line:
        raise ValueError("pamu2fcfg returned multiple lines; no mapping was saved")
    parts = line.split(":")
    if len(parts) != 2 or parts[0] != username:
        raise ValueError("pamu2fcfg returned an unexpected user or credential count")
    fields = parts[1].split(",")
    if len(fields) != 4 or not all(fields[:3]):
        raise ValueError("pamu2fcfg returned an invalid registration")
    return parts[1]


def enroll(username, label):
    input(f"Connect ONLY the {label} Solo, then press Enter (Ctrl+C cancels): ")
    result = subprocess.run(
        ["pamu2fcfg", "-u", username, "-o", ORIGIN, "-i", ORIGIN],
        check=True, stdout=subprocess.PIPE, text=True,
    )
    return registration(result.stdout, username)


def write_mapping(path, username, credentials):
    if credentials[0].split(",", 1)[0] == credentials[1].split(",", 1)[0]:
        raise ValueError("Duplicate credential handles; no mapping was saved")
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Exclusive creation also refuses symlinks. Never replace a working mapping.
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w") as target:
            target.write(username + ":" + ":".join(credentials) + "\n")
    except BaseException:
        path.unlink()
        raise


def main(argv=None):
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=state / "dotfiles/u2f_mappings",
                        help="new staging file outside the repository (never overwritten)")
    args = parser.parse_args(argv)
    if os.geteuid() == 0:
        parser.error("run as your regular user, not with sudo")
    if not sys.stdin.isatty():
        parser.error("an interactive terminal is required to switch tokens")
    if not shutil.which("pamu2fcfg"):
        parser.error("pamu2fcfg is missing; install Arch's pam-u2f package")
    path = args.output.expanduser().absolute()
    if path.resolve().is_relative_to(REPO):
        parser.error("keep enrollment mappings outside the dotfiles repository")
    if path.exists() or path.is_symlink():
        parser.error(f"{path} already exists; use --output with a new path")
    username = pwd.getpwuid(os.getuid()).pw_name
    print(f"Enrolling {username} with origin {ORIGIN}.")
    print("Creates separate non-resident PAM credentials; SSH credentials are unchanged.")
    print("Linux password + touch; this does not request a PIN on each PAM authentication.")
    try:
        primary = enroll(username, "primary")
        backup = enroll(username, "backup (disconnect the primary)")
        write_mapping(path, username, [primary, backup])
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled; PAM policy was not changed.", file=sys.stderr)
        return 1
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"Enrollment failed: {error}", file=sys.stderr)
        return 1
    print(f"Staged both registrations in {path} (mode 0600).")
    print("No live authentication configuration was changed. Follow docs/hardware-auth.md.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
